#!/bin/sh
# Aegis Wayland session — KWin 6 hosts the display, Aegis Shell is the client.
# The session ends when the shell exits.
export QT_QUICK_CONTROLS_STYLE=Basic
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
# Route Qt apps through the KDE platform theme: without this, Dolphin,
# Konsole and systemsettings ignore kdeglobals entirely and render Breeze
# Light chrome over the AegisDark scheme (observed on the v0.4.1 frames).
export QT_QPA_PLATFORMTHEME=kde

# W11 — pin the session language so the konsole.mo caption override loads
# deterministically: Qt's Wayland QPA appends the application display name
# (" — Konsole") to window titles unless the title already ends with it.
# With the override the display name IS "Aegis Terminal" and the Terminal
# title stays clean. gettext skips translations in the C locale, so both
# LANG and LANGUAGE are pinned here (LANGUAGE wins for catalog lookup).
# LANGUAGE must NOT be en_US: KI18n hardcodes en_US as the code language
# (klocalizedstring.cpp codeLanguage) and the translate loop breaks at it
# without consulting any catalog — the override therefore lives under the
# synthetic en_AEGIS tag (scripts/gen-konsole-mo.py). LANG stays en_US.UTF-8
# so date and number formats are untouched.
export LANG="${LANG:-en_US.UTF-8}"
export LANGUAGE=en_AEGIS

# Session diagnostics: when the graphical stack fails to come up, the boot
# test pipeline reads this log over the serial console.
LOG="${AEGIS_SESSION_LOG:-/tmp/aegis-session.log}"
exec >> "$LOG" 2>&1
echo "=== aegis-session start $(date) uid=$(id -u) seat=${XDG_SEAT:-UNSET} vt=${XDG_VTNR:-UNSET} XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-UNSET} ==="

# W82 — the ScreenShot2 authorization escape hatch, verified against
# kwin 6.3 screenshotdbusinterface2.cpp (checkPermissions: static bool
# permissionCheckDisabled = qEnvironmentVariableIntValue(
# "KWIN_SCREENSHOT_NO_PERMISSION_CHECKS") == 1). bt92r4 proved the
# desktop-file route is NOT deterministic in this image even with
# Exec=/usr/bin/aegis-shell and kbuildsycoca6 rc=0 (KApplicationTrader::
# query still found no matching service — the exact sycoca/service
# internals diverge in the resolute kwin build). The restricted-interfaces
# declaration stays shipped in aegis-shell.desktop; on this single-user
# reference OS the first-party shell is the only session-bus UI process,
# so the documented upstream bypass is the honest deterministic choice.
export KWIN_SCREENSHOT_NO_PERMISSION_CHECKS=1

kwin_wayland --xwayland &
KWIN_PID=$!
echo "kwin started pid=$KWIN_PID"

cleanup() {
    echo "=== aegis-session exit ==="
    [ -n "${KWIN_PID}" ] && kill "$KWIN_PID" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# Wait for the Wayland socket kwin advertises (default wayland-0)
WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
SOCKET_OK=""
for _ in $(seq 1 50); do
    if [ -n "$XDG_RUNTIME_DIR" ] && [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
        SOCKET_OK=1
        break
    fi
    if ! kill -0 "$KWIN_PID" 2>/dev/null; then
        echo "KWIN DIED EARLY"
        break
    fi
    sleep 0.1
done
echo "socket_ok=${SOCKET_OK:-NO}; runtime dir: $(ls "$XDG_RUNTIME_DIR" 2>/dev/null | tr '\n' ' ')"

# Session services — deliberately minimal for M1
command -v kded6 >/dev/null 2>&1 && kded6 >/dev/null 2>&1 &
# W82 — rebuild the KSycoca application cache up front. KWin's screenshot
# authorization resolves the DBus caller via KApplicationTrader::query
# (KWin serviceutils.h: fetchProcessServiceField matches the desktop
# file's canonical Exec path against /proc/<pid>/exe) — a cold or stale
# sycoca made the same binary flip between authorized (bt92r2) and
# NoAuthorized (bt92r3). kbuildsycoca6 indexes /usr/share/applications
# (aegis-shell.desktop ships there, Exec=/usr/bin/aegis-shell so the
# canonical paths can match) and makes the authorization deterministic.
command -v kbuildsycoca6 >/dev/null 2>&1 && kbuildsycoca6 >/dev/null 2>&1
echo "sycoca: rebuilt (rc=$?)"
# D24 (W35) — global shortcuts need the KGlobalAccel daemon (kglobalacceld
# ships via plasma-workspace Depends >= 6.2.90). Without it the pinned
# kglobalshortcutsrc dictionary is inert and the aegis-shortcuts script's
# registerShortcut calls go nowhere. Start it like kded6: present-or-skip.
# T13 D28 — the daemon opens kglobalshortcutsrc with KConfig::SimpleConfig
# (= no cascading, verified against kconfig.h:97): the /etc/xdg pins are
# INVISIBLE to it. Seed the user file from the system pins before the
# daemon starts; the aegis-shortcuts script's runtime registrations merge
# into the same file afterwards.
if [ -f /etc/xdg/kglobalshortcutsrc ] && [ ! -f "$HOME/.config/kglobalshortcutsrc" ]; then
    mkdir -p "$HOME/.config"
    cp /etc/xdg/kglobalshortcutsrc "$HOME/.config/kglobalshortcutsrc"
    echo "kglobalshortcutsrc: seeded the user file from the system pins"
fi
for KGA in /usr/lib/x86_64-linux-gnu/libexec/kglobalacceld /usr/libexec/kglobalacceld; do
    [ -x "$KGA" ] && "$KGA" >/dev/null 2>&1 &
    break
done

# W82 — clipboard history. klipper ships inside plasma-workspace; with
# kglobalacceld up, the [klipper] pin in kglobalshortcutsrc (Meta+V) pops
# its history popup. Present-or-skip like kded6: an install without the
# binary must never wedge the session.
if command -v klipper >/dev/null 2>&1; then
    klipper >/dev/null 2>&1 &
    echo "klipper: started (Meta+V = clipboard history)"
else
    echo "klipper: skipped — not installed"
fi

# W82 — the screenshot suite's save directory. The shell's
# takeScreenshot() talks to KWin's org.kde.KWin.ScreenShot2 directly
# (spectacle is not in the resolute archive) and writes
# Screenshot_<ts>.png here; the directory must exist before the first
# capture.
mkdir -p "$HOME/Pictures/Screenshots"

for PORTAL in \
    /usr/libexec/xdg-desktop-portal-kde \
    /usr/lib/x86_64-linux-gnu/libexec/xdg-desktop-portal-kde; do
    [ -x "$PORTAL" ] && "$PORTAL" >/dev/null 2>&1 &
    break
done
POLKIT_AGENT=/usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1
[ -x "$POLKIT_AGENT" ] && "$POLKIT_AGENT" >/dev/null 2>&1 &

# If kwin never produced the socket, aegis-shell cannot connect — report why
# instead of failing blind.
if [ -z "$SOCKET_OK" ]; then
    echo "FATAL: no Wayland socket after 5s; kwin output above."
    wait "$KWIN_PID"
    echo "kwin exit status: $?"
    exit 1
fi

echo "handing off to aegis-shell"
WAYLAND_DISPLAY="$WAYLAND_DISPLAY" exec /usr/bin/aegis-shell
