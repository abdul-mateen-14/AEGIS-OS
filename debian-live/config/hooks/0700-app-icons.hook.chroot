#!/bin/sh
# AEGIS Browser (aegis-browser-stable .deb r31, see docs/APP-SLOTS.md) ships
# its product logos only under /opt/aegis-browser/browser/ — its stock desktop
# entries use Icon=aegis-browser, which resolves through /usr/share/pixmaps.
# Expose the 256px logo there; the Aegis squircle dock tiles keep their own
# theme icons (web-browser / aegis-cloud / aegis-corex).
set -e

OPT_LOGO=/opt/aegis-browser/browser/product_logo_256.png
if [ -f "$OPT_LOGO" ]; then
    ln -sf "$OPT_LOGO" /usr/share/pixmaps/aegis-browser.png
fi

exit 0
