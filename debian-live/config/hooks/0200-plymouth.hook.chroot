#!/bin/sh
set -e
# Aegis boot splash: Aegis Mark on true black with hairline progress.
# Ships as a Plymouth script theme built from the branded PNGs (theme/plymouth/
# synced into includes by scripts/sync-includes.sh). Fail the BUILD (not the
# boot) when anything is missing — a silent fallback here is how v0.2.0
# regressed to a scrolling systemd console.
#
# Theme selection, plymouth 24 style (the alternatives dance alone is not
# enough: plymouth-set-default-theme and plymouthd both resolve
# /etc/plymouth/plymouthd.conf FIRST, then plymouthd.defaults, then the
# default.plymouth symlink — and the initramfs hook uses
# plymouth-set-default-theme to decide what gets copied into the initrd):
# we write plymouthd.conf explicitly AND keep the legacy symlink in sync.

if ! command -v plymouthd >/dev/null 2>&1; then
    echo "FATAL: plymouthd not found — plymouth is missing from the package" \
         "lists (see debian-live/config/package-lists/aegis-boot.list.chroot)" >&2
    exit 1
fi

if [ ! -f /usr/share/plymouth/themes/aegis/aegis.plymouth ]; then
    echo "FATAL: /usr/share/plymouth/themes/aegis missing — run scripts/sync-includes.sh" >&2
    exit 1
fi

mkdir -p /etc/plymouth
# The Aegis script theme stays installed for reference, but the SHIPPED
# theme is spinner: it is the renderer proven to paint on real firmware
# paths (the fallback splash painted fine while a script theme renders
# nothing on the same machine). Brand it: spinner's watermark becomes the
# Aegis Mark, so boot shows mark + dots on black.
printf '[Daemon]\nTheme=spinner\n' > /etc/plymouth/plymouthd.conf

if [ -d /usr/share/plymouth/themes/spinner ]; then
    cp -f /usr/share/plymouth/themes/aegis/aegis-mark.png \
          /usr/share/plymouth/themes/spinner/watermark.png
fi

update-alternatives --install /usr/share/plymouth/themes/default.plymouth \
    default.plymouth /usr/share/plymouth/themes/aegis/aegis.plymouth 200 || true
update-alternatives --set default.plymouth \
    /usr/share/plymouth/themes/aegis/aegis.plymouth || true

# Start the splash from the root filesystem only. The initramfs-phase
# plymouthd grabs the display before KMS settles and renders nothing
# (boot-tested on the CI ISOs: splash active, screen black), and its
# pidfile then blocks the root-phase plymouth-start from taking over.
# Without initramfs integration the first seconds are a quiet black
# console (quiet + loglevel=3 show nothing), then plymouth-start paints
# the splash - the exact flow the working fallback splash used.
rm -f /usr/share/initramfs-tools/hooks/plymouth \
      /usr/share/initramfs-tools/scripts/init-premount/plymouth \
      /usr/share/initramfs-tools/scripts/init-bottom/plymouth \
      /usr/share/initramfs-tools/scripts/panic/plymouth

if [ -x /usr/sbin/update-initramfs ]; then
    update-initramfs -u
fi
