#!/bin/sh
set -e
# Aegis boot splash — the W14 fallback ladder.
#
# Boot-testing every CI ISO in QEMU established three facts:
#   1. plymouthd resolves the theme through the default.plymouth
#      alternatives symlink and ignores /etc/plymouth/plymouthd.conf -
#      the symlink and the conf must agree, or every boot renders an
#      all-black screen;
#   2. C-plugin themes (ubuntu-text) painted reliably on this machine,
#      while a script theme rendered black — and four more boot tests
#      (v0.6.13, three runs) confirmed it: the aegis-mark SCRIPT theme
#      never painted a single frame on the runner;
#   3. the ruling asked for the mark on a renderer that already paints:
#      the spinner/two-step family. two-step.so ships in
#      plymouth-theme-spinner (not plymouth itself) — the package list
#      now carries it.
#
# So the ladder is: the W14 aegis-mark theme (two-step plugin — ink
# background, the mark as a centered watermark.png, a 240x2 accent
# progress line via UseProgressBar) when two-step.so AND the theme assets
# exist; otherwise the rebranded ubuntu-text stays the default. Both are
# always installed. The rebrand below runs unconditionally so the fallback
# is ready at all times.

if ! command -v plymouthd >/dev/null 2>&1; then
    echo "FATAL: plymouthd not found - plymouth is missing from the package" \
         "lists (see debian-live/config/package-lists/aegis-boot.list.chroot)" >&2
    exit 1
fi

if [ ! -f /usr/share/plymouth/themes/aegis/aegis.plymouth ]; then
    echo "FATAL: /usr/share/plymouth/themes/aegis missing - run scripts/sync-includes.sh" >&2
    exit 1
fi

UT=/usr/share/plymouth/themes/ubuntu-text/ubuntu-text.plymouth
if [ -f "$UT" ]; then
    # Aegis ink background, paper-white title, accent dots (Tokens.qml)
    sed -i \
        -e 's/^title=.*/title=Aegis OS/' \
        -e 's/^black=.*/black=0x08090C/' \
        -e 's/^white=.*/white=0xF2F4F8/' \
        -e 's/^brown=.*/brown=0x3E8BFF/' \
        -e 's/^blue=.*/blue=0x3E8BFF/' \
        "$UT"
fi

MARK=/usr/share/plymouth/themes/aegis-mark
TWO_STEP_SO=""
for f in /usr/lib/*/plymouth/two-step.so; do
    if [ -f "$f" ]; then
        TWO_STEP_SO="$f"
        break
    fi
done

if [ -n "$TWO_STEP_SO" ] \
   && [ -f "$MARK/aegis-mark.plymouth" ] \
   && [ -f "$MARK/watermark.png" ]; then
    # W14 — the mark + accent progress line, on the two-step C plugin. The
    # symlink and the conf MUST
    # agree (fact 1 above).
    update-alternatives --install /usr/share/plymouth/themes/default.plymouth \
        default.plymouth "$MARK/aegis-mark.plymouth" 210
    update-alternatives --set default.plymouth "$MARK/aegis-mark.plymouth" || true
    printf '[Daemon]\nTheme=aegis-mark\n' > /etc/plymouth/plymouthd.conf
    echo "0200: boot splash = aegis-mark (mark watermark + accent progress line; script.so: $SCRIPT_SO)"
else
    # The proven renderer stays the default until boot-capture proves the
    # mark splash (W14: "keep ubuntu-text as fallback").
    if [ -f "$UT" ]; then
        update-alternatives --install /usr/share/plymouth/themes/default.plymouth \
            default.plymouth "$UT" 200
        update-alternatives --set default.plymouth "$UT" || true
        printf '[Daemon]\nTheme=ubuntu-text\n' > /etc/plymouth/plymouthd.conf
        echo "0200: boot splash = ubuntu-text fallback (two-step.so or aegis-mark assets missing)"
    else
        echo "0200: WARNING - neither aegis-mark nor ubuntu-text could be set" >&2
    fi
fi

# Start the splash from the initramfs — the standard Ubuntu boot path.
# History of this block: an earlier pass deleted the initramfs plymouth
# integration after black-screen experiments, relying on root-phase
# plymouth-start.service. That never owned the display: every boot test
# since v0.6.13 shows casper/live-config console text flooding the frame
# from ~9 s (plymouth-start runs at 9.27 s and paints nothing it owns),
# and v0.6.20 committed those terminal lines — the W14 ruling asked for
# the mark, not console output. The two-step plugin is the SAME renderer
# chain Ubuntu's own spinner/bgrt themes run in initramfs on every
# machine, so the integration goes back: plymouthd takes the DRM master
# in init-premount, paints ink + mark + progress line, and casper text
# renders underneath until plymouth-quit hands over to SDDM.
# The renderer is chosen ONCE, at plymouthd startup: if /dev/dri/card0
# does not exist yet the DRM renderer fails and plymouthd runs headless
# for the whole boot (v0.6.21: pidfile alive from ~6 s to plymouth-quit at
# 26.8 s, zero pixels painted). MODULES=most does not ship GPU drivers and
# the FRAMEBUFFER=y hook detects no hardware in a bare build chroot, so
# the VM graphics stack must be forced into the initramfs — then card0
# exists BEFORE plymouthd starts at init-premount and the splash owns the
# display from the first second. bochs_drm covers plain -vga std QEMU.
# v0.6.22 post-mortem: the shipped initrd already carries virtio-gpu.ko
# (MODULES=most DOES include the drm stack) — but this hook's modinfo
# guard resolved against the RUNNING kernel (uname) instead of the chroot
# kernel, so every force_load silently skipped. Resolve per installed
# kernel version; force_load copies the module AND its deps and adds it
# to conf/modules so it loads before udev even runs.
cat > /usr/share/initramfs-tools/hooks/aegis-vm-gpu <<'EOF'
#!/bin/sh
PREREQ=""
prereqs()
{
        echo "$PREREQ"
}
case "$1" in
        prereqs) prereqs; exit 0 ;;
esac
. /usr/share/initramfs-tools/hook-functions
# Resolve per installed kernel version — plain `modinfo` reads uname and
# silently skips everything inside a bare build chroot (v0.6.22 lesson).
for KDIR in /lib/modules/*; do
    [ -d "$KDIR" ] || continue
    KVER="${KDIR##*/}"
    for M in virtio_gpu bochs_drm bochs; do
        if modinfo -k "$KVER" -q -n "$M" >/dev/null 2>&1; then
            force_load "$M"
        fi
    done
done
EOF
chmod +x /usr/share/initramfs-tools/hooks/aegis-vm-gpu

if [ -x /usr/sbin/update-initramfs ]; then
    update-initramfs -u
fi
