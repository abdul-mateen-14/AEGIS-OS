#!/bin/sh
# T11-D5e — deterministic app-deb install. live-build's local
# packages.chroot apt repo (file:/root/packages) intermittently drops the
# biggest deb (the 115 MB AegisBrowser): its Packages index is rescanned
# between apt passes and the INSTALL pass kept seeing the 4-deb index, so
# v0.6.29-v0.6.32 never unpacked the browser and the dock dropped its
# Tier B slot (W8: nothing on the shelf that is not installed).
#
# build-iso.sh copies every staged deb into /opt/aegis-debs via
# includes.chroot; this hook installs any of OUR packages apt missed,
# then deletes the directory so the squashfs carries no payload.
# Already-installed packages are untouched: a re-run is a no-op.
set -e

installed_any=0
for d in /opt/aegis-debs/*.deb /root/packages/*.deb /root/packages.chroot/*.deb; do
    [ -f "$d" ] || continue
    pkg=$(dpkg-deb -f "$d" Package 2>/dev/null) || continue
    case "$pkg" in
        aegis-shell|aegis-browser-stable|corex-terminal|os-private-chat|kwin4-effect-shapecorners) ;;
        *) continue ;;
    esac
    status=$(dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null) || status=""
    case "$status" in
        *"install ok installed"*) continue ;;
    esac
    echo "aegis-fallback: apt missed $pkg — dpkg -i $(basename "$d")"
    dpkg -i "$d" >/dev/null 2>&1 || true
    installed_any=1
done

# dpkg -i can leave a package unconfigured when a dependency is missing;
# -f resolves those from the normal apt sources (all standard Ubuntu libs).
if [ "$installed_any" = 1 ]; then
    apt-get install -y -f -qq >/dev/null 2>&1 || true
fi

# T15-D2 (W42) — the default browser role is wired at BUILD time. The
# skel mimeapps.list already maps http/https/html to aegis-browser.desktop
# (the deb ships that entry — verified on the r45 payload), but the role
# was never stamped through xdg-settings, so `xdg-settings get` came back
# empty and every xdg-open target outside the mapped schemes (the Drivers
# pane's "Open CUPS" runs xdg-open http://localhost:631) had no owner —
# the "Tools not working" report. Resolve the entry that REALLY exists
# (r45 ships aegis-browser.desktop AND org.aegisbrowser.Aegis.desktop),
# stamp it through xdg-settings, and re-point the skel map at it so a
# fresh live user inherits a role that resolves.
BROWSER_ENTRY=""
for D in aegis-browser org.aegisbrowser.Aegis aegis-browser-stable; do
    [ -f "/usr/share/applications/$D.desktop" ] && BROWSER_ENTRY="$D.desktop" && break
done
if [ -n "$BROWSER_ENTRY" ]; then
    # chroot-root context — makes the role resolvable system-wide and
    # keeps `xdg-settings get` (the W42 boot probe) honest
    xdg-settings set default-web-browser "$BROWSER_ENTRY" >/dev/null 2>&1 || true
    for M in x-scheme-handler/http x-scheme-handler/https text/html \
             application/xhtml+xml; do
        xdg-mime default "$BROWSER_ENTRY" "$M" >/dev/null 2>&1 || true
    done
    # skel: point the fresh-user map at the entry that exists (no-op when
    # the shipped name already matches)
    if [ -f /etc/skel/.config/mimeapps.list ]; then
        sed -i "s|=aegis-browser\.desktop\$|=$BROWSER_ENTRY|g" \
            /etc/skel/.config/mimeapps.list 2>/dev/null || true
    fi
    echo "aegis-fallback: default browser role = $BROWSER_ENTRY"
else
    echo "aegis-fallback: WARNING no browser desktop entry found — the default-browser role is unset"
fi

# W25 — electron/Chromium apps need the SUID helper root-owned 4755.
# dpkg (especially from the includes path) may not preserve the mode, and
# a non-4755 chrome-sandbox makes every electron app refuse to start.
for sb in /opt/*/chrome-sandbox /opt/*/*/chrome-sandbox \
          /usr/lib/*/chrome-sandbox; do
    [ -f "$sb" ] && chmod 4755 "$sb" && \
        echo "aegis-fallback: chmod 4755 $sb"
done

# the payload must not reach the squashfs
rm -rf /opt/aegis-debs
