#!/bin/sh
set -e
# Disc title (.disk/info) — what file managers and live-boot report.
# Runs late in the binary stage so it wins over live-build's generated copy.
# .disk/ may not exist yet when binary hooks fire — create it.
mkdir -p .disk
echo "Aegis OS 0.2" > .disk/info
echo "Aegis OS 0.2" > .disk/metadata
