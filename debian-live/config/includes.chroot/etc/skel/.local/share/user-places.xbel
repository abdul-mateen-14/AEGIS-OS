<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xbel>
<xbel xmlns:bookmark="http://www.freedesktop.org/standards/desktop-bookmarks" xmlns:mimetype="http://freedesktop.org/standards/shared-mime-info" xmlns:kde="http://www.kde.org">
 <info>
  <metadata owner="http://www.kde.org">
   <kde_places_version>4</kde_places_version>
   <withRecentlyUsed>true</withRecentlyUsed>
   <withBaloo>true</withBaloo>
   <GroupState-Places-IsHidden>false</GroupState-Places-IsHidden>
   <GroupState-Remote-IsHidden>true</GroupState-Remote-IsHidden>
   <GroupState-RecentlySaved-IsHidden>true</GroupState-RecentlySaved-IsHidden>
   <GroupState-SearchFor-IsHidden>true</GroupState-SearchFor-IsHidden>
   <GroupState-Devices-IsHidden>true</GroupState-Devices-IsHidden>
   <GroupState-RemovableDevices-IsHidden>true</GroupState-RemovableDevices-IsHidden>
   <GroupState-Tags-IsHidden>true</GroupState-Tags-IsHidden>
  </metadata>
 </info>
 <bookmark href="file:///home/aegis">
  <title>Home</title>
  <info><metadata owner="http://www.kde.org">
   <IconName>user-home</IconName>
  </metadata></info>
 </bookmark>
 <bookmark href="file:///home/aegis/Documents">
  <title>Documents</title>
  <info><metadata owner="http://www.kde.org">
   <IconName>folder-documents</IconName>
  </metadata></info>
 </bookmark>
 <bookmark href="file:///home/aegis/Downloads">
  <title>Downloads</title>
  <info><metadata owner="http://www.kde.org">
   <IconName>folder-download</IconName>
  </metadata></info>
 </bookmark>
 <bookmark href="file:///home/aegis/Pictures">
  <title>Pictures</title>
  <info><metadata owner="http://www.kde.org">
   <IconName>folder-pictures</IconName>
  </metadata></info>
 </bookmark>
 <bookmark href="trash:///">
  <title>Trash</title>
  <info><metadata owner="http://www.kde.org">
   <IconName>user-trash</IconName>
  </metadata></info>
 </bookmark>
</xbel>
