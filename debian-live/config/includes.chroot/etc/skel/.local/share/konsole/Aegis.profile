[Appearance]
ColorScheme=AegisDark
# W11 — JetBrains Mono 11 (fonts-jetbrains-mono ships in aegis-desktop.list)
Font=JetBrains Mono,11,-1,5,50,0,0,0,0,0
[General]
Name=Aegis
Parent=FALLBACK/
LocalTabTitleFormat=Aegis Terminal
RemoteTabTitleFormat=Aegis Terminal
TerminalColumn=80
TerminalRow=24
[Interaction Options]
WordCharacters=:@-./_~?&=%+
[Scrolling]
# W11 — no scrollbar chrome (0 = left, 1 = right, 2 = hidden)
ScrollBarPosition=2
