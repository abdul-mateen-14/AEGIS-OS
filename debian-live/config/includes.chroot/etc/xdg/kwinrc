[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__AegisLights
ButtonsOnLeft=XIA
ButtonsOnRight=
BorderSizeAuto=false
# W11 — None = borders 0/44/0/0: the client is flush with the window edge
# below the 44 px glass band (the AppWindow.qml anatomy). The aurorae v2
# engine clamps theme Border* to this size (Normal would clamp 12 → 6 and
# leave the client inside a body-coloured strip with the band arc floating
# inset — "the header is smaller than the body"). Resizing still works
# through KWin's resize-only borders; corners round via ShapeCorners below.
BorderSize=None

[Effect-blur]
BlurDecorations=true

[Plugins]
# Table 18 — radius 18 on all four corners (0800 hook installs the effect).
kwin4_effect_shapecornersEnabled=true
# M3 — Mission Control: the stock Overview grid on Meta+W (all windows +
# workspaces as pages) is declared explicitly so the shortcut dictionary in
# docs/DESIGN-TOKENS.md Table 10 is guaranteed, not assumed.
overviewEnabled=true

[Effect-shapecorners]
Radius=18

# M3 — Depth: four workspaces (Meta+Ctrl arrows / three-finger swipe),
# Overview mission control (Meta+W, stock effect), custom tiling (Meta+T,
# stock). The shell exposes them as-is; the gesture dictionary lives in
# docs/DESIGN-TOKENS.md Table 10.
[Desktops]
Number=4
Rows=1

