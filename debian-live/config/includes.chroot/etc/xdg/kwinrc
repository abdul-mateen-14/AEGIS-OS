[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__AegisLights
ButtonsOnLeft=XIA
ButtonsOnRight=
BorderSizeAuto=false
# W11 — None = borders 0/44/0/0: the client is flush with the window edge
# below the 44 px glass band (the AppWindow.qml anatomy). The aurorae v2
# engine clamps theme Border* to this size (Normal would clamp 12 → 6 and
# leave the client inside a body-coloured strip with the band arc floating
# inset — "the header is smaller than the body").
#
# T15-D7 (W44) — the review's claim "resizing still works through KWin's
# resize-only borders (settings largeSpacing)" had no probe behind it, and
# the T15 boot gate PROVED it false: two runs, right-edge drags at hairline
# end +2/+6 on Konsole grew the window 0 px under BorderSize=None. The
# review's prescribed flip applies verbatim: BorderSize=Tiny (4 px strips;
# the aurorae theme's own 44 px titleband and the W10 button metrics are
# unchanged). The W44 terminal drag probe re-asserts resize per run, and
# the T7 header assert guards the button geometry.
BorderSize=Tiny

[Effect-blur]
BlurDecorations=true

[Plugins]
# Table 18 — radius 18 on all four corners (0800 hook installs the effect).
kwin4_effect_shapecornersEnabled=true
# M3 — Mission Control: the stock Overview grid on Meta+W (all windows +
# workspaces as pages) is declared explicitly so the shortcut dictionary in
# docs/DESIGN-TOKENS.md Table 10 is guaranteed, not assumed.
overviewEnabled=true
# W20 — real window tracking: counts normal windows on the active
# workspace and pushes org.aegis.Shell.windowListChanged (island
# auto-hide predicate + dock running dots for foreign-launched apps).
# Key shape = the VERBATIM plugin id + Enabled (the KWin pattern —
# kwin4_effect_shapecornersEnabled for the id kwin4_effect_shapecorners;
# the camelCase aegisWindowwatchEnabled loaded nothing and the boot
# gate's isScriptLoaded went red on the v0.6.35 run 3).
aegis-windowwatchEnabled=true
# D24 (W35) — the shell's Meta+Space / Meta+S global shortcuts ride
# KGlobalAccel through this script (the stock dictionary is pinned in
# /etc/xdg/kglobalshortcutsrc; shell actions cannot ride that file
# because nothing registers them there).
aegis-shortcutsEnabled=true
# W21 — dock-anchored open/close (the stock scale effect is ALSO a
# toplevel-open-close-animation effect; both grabbing windowAdded is
# undefined — the stock one is disabled for the tile-anchored one).
# Same verbatim-id key shape.
aegis-dockzoomEnabled=true
scaleEnabled=false
# D20 (W27) — minimize/restore animation. Our JS effect cannot hook
# minimize on 6.6 (EffectsHandler exposes only windowAdded/Closed/
# Activated/Deleted to JS — verified against the KWin 6.6.0 source), so
# the "minimize goes somewhere" ruling rides the stock squash effect,
# which animates exactly minimize + unminimize. Scale stays off (it
# would grab open/close and fight the dockzoom).
squashEnabled=true

[Effect-shapecorners]
Radius=18

# M3 — Depth: four workspaces (Meta+Ctrl arrows / three-finger swipe),
# Overview mission control (Meta+W, stock effect), custom tiling (Meta+T,
# stock). The shell exposes them as-is; the gesture dictionary lives in
# docs/DESIGN-TOKENS.md Table 10.
[Desktops]
Number=4
Rows=1

