[Unit]
Description=Aegis first-boot GPU driver enablement (NVIDIA via ubuntu-drivers)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/sbin/aegis-drivers

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/aegis-drivers
RemainAfterExit=yes
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
