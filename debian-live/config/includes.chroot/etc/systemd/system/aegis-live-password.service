[Unit]
Description=Aegis OS - set the documented live-session password (aegis)
# casper creates the live user at boot with the legacy DES hash
# U6aMy0wojraho — modern libcrypt cannot evaluate DES, so unix_chkpwd
# rejects EVERY password check for that account (bt70 discovered this
# via the direct aegis-auth probe; nullok in common-auth does not help
# because the hash itself is unreadable). Give the live user a real,
# documented password so the lock screen, PAM and the boot test's
# unlock chain all work. Live rootfs only: Calamares
# remove-live-autologin deletes this unit from the installed system.
After=systemd-user-sessions.service
Before=display-manager.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c "echo 'aegis:aegis' | chpasswd"

[Install]
WantedBy=multi-user.target
