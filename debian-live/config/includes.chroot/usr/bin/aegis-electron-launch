#!/bin/sh
# W25 — electron/Chromium launch guard. The dock (and anything else)
# launches the resolved .desktop Exec through this wrapper when the app
# ships a chrome-sandbox next to its binary. In a VM (or with
# AEGIS_VM_MODE=1) there is no accelerated GL, so Chromium renders black
# or crashes: add --disable-gpu. --no-sandbox is added UNCONDITIONALLY in
# VM mode: the v0.6.40 boot run proved the SUID helper still fails with
# Permission denied (credentials.cc FATAL) even after the 4755 chmod —
# the guest's root is mounted nosuid and user namespaces are
# unavailable. This wrapper only ever engages in a VM; the metal path
# keeps the real sandbox.
#
# T15-D2 (W42) — --no-first-run --no-default-browser-check ride EVERY
# launch in ALL modes (harmless to non-Chromium binaries — the D16
# note; they are Chromium switches the other heads ignore). The W42
# review round proved both gaps user-visibly: without --no-first-run
# the Chromium first-run/welcome page covers the browser window on
# every fresh live session (the user's "it is opening another dialog
# on it" — the 04g-browser.png ToS/first-run capture), and without
# --no-default-browser-check Chromium also pops its default-browser
# prompt. The OS-side default browser is wired at build time in the
# 0900 hook (xdg-settings), so the check would never fire anyway —
# belt and braces.
FLAGS="--no-first-run --no-default-browser-check"

# W59 — Chromium must follow the shell's dark-mode rung: the browser
# reads GTK_THEME at launch, so export it from the same prefs.json
# aegis-gtk-sync consumes (one source of truth, no half-dark desktop).
# Explicit decision: content darkening is NOT forced (--force-dark-mode
# stays off) — the chrome follows the scheme, web content stays honest.
DARK=true
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
if [ -f "$RUNTIME/aegis/prefs.json" ]; then
    D=$(grep -o '"darkMode":[a-z]*' "$RUNTIME/aegis/prefs.json" 2>/dev/null | cut -d: -f2)
    [ "$D" = "false" ] && DARK=false
fi
if [ "$DARK" = "true" ]; then
    GTK_THEME=adw-gtk3-dark
    [ -d /usr/share/themes/adw-gtk3 ] || GTK_THEME=Adwaita-dark
else
    GTK_THEME=adw-gtk3
    [ -d /usr/share/themes/adw-gtk3 ] || GTK_THEME=Adwaita
fi
export GTK_THEME
VM=0
if [ "$AEGIS_VM_MODE" = "1" ]; then
    VM=1
elif grep -qiE 'virtualbox|vmware|qemu|kvm' /sys/class/dmi/id/product_name \
        /sys/class/dmi/id/sys_vendor 2>/dev/null; then
    # v0.6.44 run: the QEMU guest's product_name is "Standard PC (Q35 +
    # ICH9, 2009)" — no qemu/kvm in it; QEMU identifies via sys_vendor.
    VM=1
fi
if [ "$VM" = 1 ]; then
    # W53 — --test-type suppresses Chromium's "unsupported command-line
    # flag: --no-sandbox" infobar (the flag itself STAYS: the nosuid
    # live root genuinely needs it, per the v0.6.40 run). VM-only polish;
    # on the metal the sandbox stays on and no infobar ever appears.
    # The real fix (traffic lights drawn in the browser's frame view)
    # lives in the browser repo's own tracker.
    FLAGS="$FLAGS --disable-gpu --no-sandbox --test-type"
fi
exec "$@" $FLAGS
