<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.w3.org/2001/XMLSchema-instance
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
    <kcfgfile name=""/>
    <group name="">
        <!-- W21 — the dock tile centers the shell publishes; the effect
             cannot callDBus (KWin 6.6 gives callDBus to window scripts,
             not to effects), so the map travels through this config key:
             the shell writes kwinrc [Effect-aegis-dockzoom] TileMap and
             KConfigWatcher refreshes the effect via configChanged. -->
        <entry name="TileMap" type="String">
            <default>{}</default>
        </entry>
    </group>
</kcfg>
