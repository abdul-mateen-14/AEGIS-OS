[General]
ActiveTextColor=224,226,232
InactiveTextColor=150,155,166
TitleAlignment=Center
TitleVerticalAlignment=Center
UseTextShadow=false
Animation=80
# T16 §5.3.1 — the aurorae v2 engine (KWin 6.6, plasma/aurorae
# decoration.cpp) has no Shadow key: the shadow renders whenever the
# [Layout] Padding* margins are non-null (updateShadow paints the frame
# grown by padding, erases the interior with DestinationOut, and the
# remaining ring IS the DecorationShadow). The old Shadow=false line
# disabled nothing; the padding below is what turns the shadow on.
# Maximized windows keep the unshifted decoration-maximized elements
# (no shadow ring, v0.6.27 geometry).
Shadow=true
DecorationPosition=Top
LeftButtons=XIA
RightButtons=

[Layout]
# T15-D7 (W44) — 4 px side/bottom borders (the session BorderSize=Tiny
# clamps these to exactly 4). The W44 boot probe PROVED the old 0/44/0/0
# declaration non-resizable (two runs of right-edge drags grew Konsole
# 0 px — there was NO interactive margin to hit), so the decorated path
# gets real resize handles now. The 44 px titleband, the W10 button
# metrics and the r18 ShapeCorners corners are unchanged; the client
# sits 4 px inside the frame on the sides/bottom (the review accepted
# this trade verbatim).
BorderLeft=4
BorderRight=4
BorderBottom=4
BorderTop=44
TitleEdgeTop=10
TitleEdgeBottom=10
TitleEdgeLeft=18
TitleEdgeRight=16
TitleEdgeLeftMaximized=18
TitleEdgeRightMaximized=16
TitleEdgeTopMaximized=10
TitleEdgeBottomMaximized=10
TitleBorderLeft=24
TitleBorderRight=78
TitleHeight=24
# W10 — ONE traffic-light anatomy with the shell (AppWindow.qml / aurorae v2
# in Plasma 6.6, decoration.cpp positionButtons/captionRect):
#   dots   y = TitleEdgeTop + ButtonMarginTop = 16..28  (center 22)
#   caption y band = [TitleEdgeTop, +max(TitleHeight, ButtonHeight)] = 10..34
#   → ButtonMarginTop=6 puts the dot center on the caption text center (22).
#   Buttons start exactly at TitleEdgeLeft in 6.6 v2; the measured glyph lands
#   at TitleEdgeLeft - 4, so 18 puts the red dot edge at 14 = shell x:14.
#   Caption rect = [leftButtons.right + TitleBorderLeft,
#                   width - TitleEdgeRight - TitleBorderRight] = [94, w-94]
#   → TitleBorderRight=78 centers the caption on the true window center.
# borders().top = max(TitleHeight, ButtonHeight + ButtonMarginTop)
#              + TitleEdgeTop + TitleEdgeBottom = 24 + 20 = 44 = shell band.
#
# W11/W44 border history: the v0.6.27 zero-side ruling ("header smaller
# than body") declared 0/44/0/0 and the session ran BorderSize=None — but
# the T15 boot probe proved that state NON-RESIZABLE (KWin hit-tests the
# theme-declared border margins; declared 0 = nothing to hit, whatever the
# session size). The W44 ruling restores 4 px sides under BorderSize=Tiny:
# the client sits 4 px inside the frame on sides/bottom, the 44 px band and
# W10 metrics are untouched, and the drag probe re-asserts resize per run.
# All four corners still round through the ShapeCorners effect (Radius=18;
# the frame SVG's top arcs are r18 to match).
ButtonWidth=12
ButtonHeight=12
ButtonWidthClose=12
ButtonWidthMinimize=12
ButtonWidthMaximizeRestore=12
ButtonSpacing=8
ButtonMarginTop=6
ButtonMarginTopMaximized=6
# ButtonMarginLeft/Right/Bottom are dead keys in the Plasma 6.6 aurorae v2
# engine (decorationtheme.cpp reads only ButtonSpacing, ButtonMarginTop(Max),
# ExplicitButtonSpacer) — horizontal placement comes from TitleEdgeLeft.
ExplicitButtonSpacer=8
# T16 §5.3.1 — the shadow ring: ambient spread 20 px + key offset-y 4 px
# blur 32 px, as one gradient band per edge (24 left/right, 20 top,
# 36 bottom). These MUST equal the SVG element sizes in
# scripts/gen-aurorae-frame.py — FrameSvg derives its stretch margins
# from the elements, and DecorationTheme::padding() reads these keys.
PaddingLeft=24
PaddingRight=24
PaddingTop=20
PaddingBottom=36
