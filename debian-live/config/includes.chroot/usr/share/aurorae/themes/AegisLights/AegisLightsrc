# W10 — ONE traffic-light anatomy with the shell (AppWindow.qml / aurorae v2
# in Plasma 6.6, decoration.cpp positionButtons/captionRect):
#   dots   y = TitleEdgeTop + ButtonMarginTop = 16..28  (center 22)
#   caption y band = [TitleEdgeTop, +max(TitleHeight, ButtonHeight)] = 10..34
#   → ButtonMarginTop=6 puts the dot center on the caption text center (22).
#   Buttons start exactly at TitleEdgeLeft in 6.6 v2; the measured glyph lands
#   at TitleEdgeLeft - 4, so 18 puts the red dot edge at 14 = shell x:14.
#   Caption rect = [leftButtons.right + TitleBorderLeft,
#                   width - TitleEdgeRight - TitleBorderRight] = [94, w-94]
#   → TitleBorderRight=78 centers the caption on the true window center.
# borders().top = max(TitleHeight, ButtonHeight + ButtonMarginTop)
#              + TitleEdgeTop + TitleEdgeBottom = 24 + 20 = 44 = shell band.
#
# W11 — ZERO side borders, ONE anatomy (v0.6.27; "header smaller than body"):
#   the 6.6 v2 engine CLAMPS Border* to the session border size
#   (decorationtheme.cpp borders(): BorderSize=Normal clamps 4..6), so the
#   declared 12 px sides really rendered 6 px and the client sat inside a
#   body-coloured strip while the band's arc floated inset. The session now
#   runs BorderSize=None (etc/xdg/kwinrc) → borders 0/44/0/0: the client is
#   flush with the window edge below the 44 px glass band — the AppWindow.qml
#   anatomy — and all four corners round through the ShapeCorners effect
#   (Radius=18; the frame SVG's top arcs are r18 to match). These Border*
#   values are the honest declaration of that state; the engine zeroes them
#   under None regardless. Side/bottom resize handles come from KWin's
#   resize-only borders (settings largeSpacing) — windows stay resizable.
ButtonWidth=12
ButtonHeight=12
ButtonWidthClose=12
ButtonWidthMinimize=12
ButtonWidthMaximizeRestore=12
ButtonSpacing=8
ButtonMarginTop=6
ButtonMarginTopMaximized=6
# ButtonMarginLeft/Right/Bottom are dead keys in the Plasma 6.6 aurorae v2
# engine (decorationtheme.cpp reads only ButtonSpacing, ButtonMarginTop(Max),
# ExplicitButtonSpacer) — horizontal placement comes from TitleEdgeLeft.
ExplicitButtonSpacer=8
