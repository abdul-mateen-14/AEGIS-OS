# Aegis OS desktop core — M1 "Shell core" (proposal §9.2)
#
# Session: KWin 6 Wayland (Kubuntu 26.04 LTS ships Plasma 6.6 LTS / Qt 6).
# plasma-workspace is kept as the fallback session + kded6/portal provider;
# the Aegis session (wayland-sessions/aegis.desktop) is the featured one.

# Compositor + session infra
kwin-wayland
xwayland
plasma-workspace
plasma-desktop
powerdevil
kinfocenter
systemsettings
polkit-kde-agent-1
# W30.1 — the Displays pane parses kscreen-doctor output; plasma-workspace
# does not guarantee the kscreen package, so the pane degraded to its
# "not available" state on the VM round. kscreen ships kscreen-doctor.
kscreen

# Login manager
sddm

# M1 first-party surfaces: Files · Terminal
dolphin
konsole

# Network (auto-connect on boot; GUI tray arrives in M2)
network-manager
wireless-regdb
plasma-nm

# Bluetooth
bluez
bluez-cups

# Audio (PipeWire stack)
pipewire
pipewire-pulse
wireplumber

# Printing & scanning — out of the box (Table 22)
cups
printer-driver-gutenprint
# W33.2 — the review's "pdfs" ask: Print-to-PDF exists as a printer out
# of the box (the Drivers pane's test page lands in ~/PDF).
cups-pdf
sane-utils
simple-scan

# Drivers & firmware — complete, no downloads at first boot (Table 22)
linux-firmware
mesa-vulkan-drivers
va-driver-all
fwupd
ubuntu-drivers-common

# Secure Boot chain for the installed system
grub-efi-amd64
grub-efi-amd64-signed
shim-signed

# Memory: zram default (Table 19)
zram-tools

# Fonts: Montserrat is the Aegis design language; Noto covers the rest
fonts-montserrat
fonts-noto-core
fonts-noto-color-emoji
# W11 — the Terminal profile font (Aegis.profile: JetBrains Mono 11)
fonts-jetbrains-mono
# W11 — locales for the en_US.UTF-8 caption override (konsole.mo)
locales

# Portals (file dialogs, screenshots, remote desktop)
xdg-desktop-portal
xdg-desktop-portal-kde
xdg-desktop-portal-gtk

# Icon themes — the shell's image://icons provider resolves dock/panel
# glyphs through QIcon::fromTheme; with no theme installed every lookup
# returned empty and the dock rendered without icons.
breeze-icon-theme
breeze-cursor-theme
hicolor-icon-theme
