# Runtime deps for the Aegis Shell (Qt Quick 6 on KWin 6 Wayland + LayerShellQt).
# The aegis-shell .deb itself is staged in config/packages.chroot/.
layer-shell-qt
qt6-wayland
qml6-module-qtquick
qml6-module-qtquick-controls
qml6-module-qtquick-layouts
qml6-module-qtquick-templates
qml6-module-qtqml-workerscript
qml6-module-qtquick-window
# First-party apps (aegis-files / aegis-settings): FolderListModel for the
# Files views, QtQuick.Dialogs for the Wallpaper "Choose image…" picker.
qml6-module-qt-labs-folderlistmodel
qml6-module-qtquick-dialogs
# M3 — aegis-music: Qt Multimedia over PipeWire (the Qt FFmpeg backend
# decodes mp3/flac/ogg/wav/m4a/opus; gst good/base cover the residual
# container/rtp edges and pipewire sink handoff).
qml6-module-qtmultimedia
libqt6multimedia6
gstreamer1.0-plugins-base
gstreamer1.0-plugins-good
gstreamer1.0-pipewire
# W3/W6 backends: Qt Network + Concurrent run the Aegis ID HTTP/KDF stack
libqt6network6
libqt6concurrent6
fonts-montserrat
