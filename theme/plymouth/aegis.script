# Aegis OS boot splash (proposal, chapter 07).
# True black, the Aegis Mark dead center, a 240x2 hairline progress bar
# 36 px below it. Real progress comes from systemd through
# SetBootProgressFunction; until the first event arrives the bar shows a
# small indeterminate head, and the fill eases toward the target so the
# bar never jumps. Written in the exact dialect of plymouth's shipped
# script demo theme (plain globals, Sprite(image), SetPosition/SetZ,
# one refresh callback), ASCII-only, no message hooks.
#
# v0.2.0 regressed to a scrolling console because the plymouth package
# itself was missing (aegis-boot.list.chroot fixes that); this script is
# deliberately boring so it can never regress the same way again.

Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

logo.image = Image("aegis-mark.png");
logo.sprite = Sprite(logo.image);

bar.width = 240;
bar.height = 2;
track.image = Image("track.png");
track.sprite = Sprite(track.image);
fill.image = Image("fill.png");
fill.sprite = Sprite(fill.image);
fill.percent = 0.0;

fun refresh_callback ()
  {
    logo.sprite.SetX (Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
    logo.sprite.SetY (Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
    logo.sprite.SetOpacity (1);

    track.sprite.SetX (Window.GetX() + Window.GetWidth() / 2 - bar.width / 2);
    track.sprite.SetY (Window.GetY() + Window.GetHeight() / 2 + 96 / 2 + 36);
    track.sprite.SetZ (10);
    track.sprite.SetOpacity (0.28);

    fill.sprite.SetX (track.sprite.GetX());
    fill.sprite.SetY (track.sprite.GetY());
    fill.sprite.SetZ (11);

    w = bar.width * fill.percent;
    if (w < 1)
      w = 1;
    if (w > bar.width)
      w = bar.width;
    fill.sprite.SetImage (fill.image.Scale (w, bar.height));
  }

Plymouth.SetRefreshFunction (refresh_callback);

fun boot_progress_callback (duration, progress)
  {
    fill.percent = progress;
  }

Plymouth.SetBootProgressFunction (boot_progress_callback);
