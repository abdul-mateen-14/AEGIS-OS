# Aegis OS boot splash — the W14 ruling.
#
# Ink background (#08090C), the Aegis mark as a centered watermark, and a
# 240x2 accent progress line 36 px below it. Real progress comes from
# systemd through SetBootProgressFunction; until the first event arrives
# the line shows a small indeterminate head, and the fill eases toward the
# target so the bar never jumps.
#
# Written in the exact dialect of plymouth's shipped script demo theme
# (plain globals, Sprite(image), SetPosition/SetZ, one refresh callback),
# ASCII-only, no message hooks. The v0.2 splash regressed to a black screen
# once because the alternatives symlink outran the assets — the 0200 hook
# now only points default.plymouth here when script.so AND all four assets
# exist, with the rebranded ubuntu-text kept as the fallback renderer.

Window.SetBackgroundTopColor(0.031, 0.035, 0.047);
Window.SetBackgroundBottomColor(0.031, 0.035, 0.047);

logo.image = Image("watermark.png");
logo.sprite = Sprite(logo.image);

bar.width = 240;
bar.height = 2;
bar.topGap = 36;
track.image = Image("track.png");
track.sprite = Sprite(track.image);
fill.image = Image("fill.png");
fill.sprite = Sprite(fill.image);
fill.percent = 0.0;

fun refresh_callback ()
  {
    logo.sprite.SetX (Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
    logo.sprite.SetY (Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
    logo.sprite.SetOpacity (1);

    track.sprite.SetX (Window.GetX() + Window.GetWidth() / 2 - bar.width / 2);
    track.sprite.SetY (Window.GetY() + Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + bar.topGap);
    track.sprite.SetZ (10);
    track.sprite.SetOpacity (1);

    fill.sprite.SetX (track.sprite.GetX());
    fill.sprite.SetY (track.sprite.GetY());
    fill.sprite.SetZ (11);

    w = bar.width * fill.percent;
    if (w < 1)
      w = 1;
    if (w > bar.width)
      w = bar.width;
    fill.sprite.SetImage (fill.image.Scale (w, bar.height));
  }

Plymouth.SetRefreshFunction (refresh_callback);

fun boot_progress_callback (duration, progress)
  {
    fill.percent = progress;
  }

Plymouth.SetBootProgressFunction (boot_progress_callback);
