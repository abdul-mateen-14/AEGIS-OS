[Plymouth Theme]
Name=Aegis Mark
Description=Aegis OS boot splash - ink background, the Aegis mark as a centered watermark, a thin accent progress line
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/aegis-mark
Font=Ubuntu 12
HorizontalAlignment=.5
VerticalAlignment=.5
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.46
ProgressBarHorizontalAlignment=.5
ProgressBarVerticalAlignment=.61
ProgressBarWidth=240
ProgressBarHeight=2
ProgressBarForegroundColor=0x3E8BFF
ProgressBarBackgroundColor=0x232A36
BackgroundStartColor=0x08090C
BackgroundEndColor=0x08090C
Transition=none
TransitionDuration=0.0
DialogClearsFirmwareBackground=false
MessageBelowAnimation=true

[boot-up]
UseProgressBar=true
UseEndAnimation=false
UseFirmwareBackground=false

[shutdown]
UseProgressBar=false
UseEndAnimation=false
UseFirmwareBackground=false

[reboot]
UseProgressBar=false
UseEndAnimation=false
UseFirmwareBackground=false
